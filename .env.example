# Environment
APP_ENV=local
APP_BASE_URL=http://localhost:8080

# Browser Execution (chromium, firefox, webkit)
APP_BROWSER=chromium
APP_HEADLESS=true
APP_SLOW_MO_MS=0
APP_TIMEOUT_MS=10000

# Viewport
APP_VIEWPORT_WIDTH=1280
APP_VIEWPORT_HEIGHT=720

# Diagnostics & Reporting
APP_TRACE_ON_FAILURE=true
APP_SCREENSHOT_ON_FAILURE=true
APP_COMPANY_LOGO=assets/company_logo.svg
APP_REPORTS_DIR=reports
APP_LOG_LEVEL=INFO
